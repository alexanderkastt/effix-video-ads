# ─── APIs ────────────────────────────────────────
FAL_API_KEY=tu_key_aqui
ELEVENLABS_API_KEY=tu_key_aqui
SUNO_API_KEY=tu_key_aqui

# ─── Feria Effix — branding ──────────────────────
EVENTO_NOMBRE=Feria Effix 2026
EVENTO_FECHAS=15 al 19 de octubre
EVENTO_LUGAR=Plaza Mayor Medellín
EVENTO_CODIGO_DESCUENTO=EFFIX20
EVENTO_LINK_REFERIDO=https://feriaeffix.com/?ref=alexander

# ─── ElevenLabs — voz de marca (settings validados) ──
# Estos son los valores que corren de verdad. Estaban en 0.28 / 0.83 mientras
# el .env real usaba otros, asi que un entorno recien clonado locutaba a otra
# velocidad y descuadraba la duracion de todos los clips.
ELEVENLABS_VOICE_ID=tu_voice_id_aqui
ELEVENLABS_MODEL=eleven_multilingual_v2
# 0.28 con speed alto atropellaba la frase; 0.45 la sostiene.
ELEVENLABS_STABILITY=0.45
ELEVENLABS_SIMILARITY=0.83
ELEVENLABS_STYLE=0.12
ELEVENLABS_SPEED=1.15
ELEVENLABS_SPEAKER_BOOST=true
# Aire entre replicas, en segundos. Mas que esto deja hueco muerto.
RESPIRO_S=0.12
# Palabras por segundo de la voz real. Se mide con scripts/calibrar_voz.py
# cada vez que cambia la voz o el speed; sirve para estimar antes de gastar.
PALABRAS_POR_SEGUNDO=2.96

# ─── fal.ai — modelo por defecto ─────────────────
FAL_MODEL_VIDEO=fal-ai/kling-video/v2.1/standard/image-to-video
FAL_MODEL_IMAGE=fal-ai/flux/schnell
# Lip-sync: sync-lipsync 0.70 USD/min | sync-lipsync/v3 8 USD/min | sync-lipsync/react-1 10 USD/min
FAL_MODEL_LIPSYNC=fal-ai/sync-lipsync
# Solo los lee react-1: emocion (happy|sad|angry|disgusted|surprised|neutral)
# y cuanto de la cara mueve (lips|face|head).
FAL_LIPSYNC_EMOTION=neutral
FAL_LIPSYNC_MODE=face
FAL_ASPECT_RATIO=9:16
# Ventana de cada clip. Kling cobra tramos de 5s: en 4s se paga un
# segundo por clip que nunca se ve. 4 = ritmo UGC, 5 = cine.
DURACION_CLIP_S=5
FAL_RESOLUTION=720p

# ─── Pipeline ─────────────────────────────────────
MAX_CONCURRENT_CLIPS=3
CLIP_DURATION_SECONDS=4
TOTAL_CLIPS=11

# ─── Ritmo de montaje ─────────────────────────────
# El corte visual no espera a que termine la frase: una linea larga se parte
# en dos o tres planos del MISMO clip, reencuadrados. No cuesta video nuevo.
PLANO_MIN_S=1.5
PLANO_MAX_S=2.5
# Push-in continuo con zoompan. Apagado por defecto: es lento y hace jitter.
RITMO_PUSH_IN=0

# ─── Musica de fondo ──────────────────────────────
# Volumen de la pista bajo la voz, con el sidechain de src/mezcla.py.
MUSICA_VOLUMEN=0.18
# Rango del video final. El numero de clips lo calcula plan_clips.py
# a partir de la locucion; estos son el piso y el techo.
VIDEO_MIN_S=30
VIDEO_MAX_S=60
